#!/usr/bin/expect -f

log_user 0
log_file -a output.txt

set timeout 30

puts "connecting to ISAM"
spawn ssh isadmin@10.128.160.53

expect "*password:"
send "ANS#150\r"

puts "RUNNING COMMANDS"
puts "1/5"
expect ">"
send "show software-mngt oswp\r"

puts "2/5"
expect ">"
send "show equipment slot\r"

puts "3/5"
expect ">"
send "show pon unprovision-onu\r"

puts "4/5"
expect ">"
send "show pon ber-stats\r"

puts "5/5"
expect ">"
send "show equipment ont status pon\r"

puts "LOGGING OUT"
expect ">"
send "logout\r"

puts "output saved to output.txt"

expect eof
